/* ================================================================
 * 阴阳象棋 —— 页面样式（设计语言沿用 v0zip 楚汉象棋：中国风 × 玻璃拟态）
 * 主题切换：.theme-dark / .theme-light 覆盖 CSS 变量
 * ================================================================ */

.theme-dark {
  --bg: #0f0b08;
  --bg-2: #1b130d;
  --text: #f3e6cc;
  --sub: rgba(243, 230, 204, 0.52);
  --gold: #d9b26a;
  --gold-soft: rgba(217, 178, 106, 0.18);
  --cinnabar: #c8372d;
  --glass: rgba(255, 240, 215, 0.055);
  --glass-strong: rgba(255, 240, 215, 0.09);
  --glass-border: rgba(217, 178, 106, 0.2);
  --shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.55);
  --sheet: #1a130d;
  --icon-filter: none;
}

.theme-light {
  --bg: #efe5d3;
  --bg-2: #e3d4b8;
  --text: #3a2414;
  --sub: rgba(58, 36, 20, 0.55);
  --gold: #9a6a2a;
  --gold-soft: rgba(154, 106, 42, 0.14);
  --cinnabar: #b42d23;
  --glass: rgba(255, 252, 245, 0.55);
  --glass-strong: rgba(255, 252, 245, 0.8);
  --glass-border: rgba(154, 106, 42, 0.22);
  --shadow: 0 24rpx 60rpx rgba(90, 55, 20, 0.25);
  --sheet: #f6eedf;
  --icon-filter: brightness(0.62) saturate(1.2);
}

.page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 46%, var(--bg) 100%);
  color: var(--text);
  transition: background 0.4s ease, color 0.4s ease;
}

.ambient {
  position: absolute;
  width: 900rpx;
  height: 900rpx;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(60px);
  opacity: 0.35;
}
.ambient-top {
  top: -520rpx;
  left: -200rpx;
  background: radial-gradient(circle, rgba(200, 55, 45, 0.55), transparent 65%);
}
.ambient-bottom {
  bottom: -560rpx;
  right: -260rpx;
  background: radial-gradient(circle, rgba(217, 178, 106, 0.45), transparent 65%);
}

.glass {
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* ============================ 导航栏 ============================ */
.navbar {
  position: relative;
  width: 100%;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  /* 标题紧跟左侧图标组（不再居中），为右上角「双人/人机」按钮留出空间 */
  justify-content: flex-start;
  z-index: 2;
}
.nav-actions {
  position: absolute;
  left: 24rpx;
  bottom: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  transition: transform 0.15s ease;
}
.nav-icon {
  width: 34rpx;
  height: 34rpx;
  filter: var(--icon-filter);
}
.pressed {
  transform: scale(0.9);
  background: var(--glass-strong);
}
/* 棋局模式切换按钮（太阳 / 月亮）：略作强调，便于识别 */
.nav-mode {
  border-color: rgba(217, 178, 106, 0.5);
  box-shadow: 0 0 18rpx rgba(217, 178, 106, 0.28);
}

/* 右上角：对战模式切换（双人 ⇄ 人机），位于微信系统胶囊左侧。
   right 由 JS 按 getMenuButtonBoundingClientRect 动态计算，避免与胶囊重叠 */
.nav-actions-right {
  position: absolute;
  bottom: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  z-index: 3;
}
.nav-pill {
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--glass);
  border: 2rpx solid var(--glass-border);
  transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}
.nav-pill-text {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--text);
  white-space: nowrap;
}
.nav-pill.active {
  border-color: rgba(217, 178, 106, 0.5);
  box-shadow: 0 0 18rpx rgba(217, 178, 106, 0.28);
  background: var(--gold-soft);
}
.nav-pill.active .nav-pill-text {
  color: var(--gold);
}

.now-player {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(217, 178, 106, 0.32);
  background: var(--gold-soft);
}
.now-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c8372d;
}
.now-dot.now-black {
  background: #2b2b2b;
}
.now-text {
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 1rpx;
}

/* 标题永久居中：绝对定位铺满导航栏后水平居中；pointer-events 放行两侧按钮点击 */
.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 1;
}
.title {
  font-size: 38rpx;
  letter-spacing: 3rpx;
  color: var(--text);
  white-space: nowrap;
}

/* ============================ 状态栏 ============================ */
.status {
  position: relative;
  z-index: 1;
  width: calc(100% - 48rpx);
  margin-top: 16rpx;
  padding: 20rpx 22rpx 16rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow);
}
.status-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.player {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  transition: all 0.35s ease;
  opacity: 0.6;
}
.player-right {
  padding: 8rpx 8rpx 8rpx 14rpx;
}
.player.active {
  opacity: 1;
  background: var(--gold-soft);
  border-color: var(--glass-border);
}
.player.active-r .avatar {
  box-shadow: 0 0 0 3rpx rgba(243, 209, 132, 0.9), 0 0 24rpx rgba(229, 84, 60, 0.7);
}
.player.active-b .avatar {
  box-shadow: 0 0 0 3rpx rgba(223, 227, 232, 0.9), 0 0 24rpx rgba(223, 227, 232, 0.45);
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 64rpx;
  font-size: 34rpx;
  transition: box-shadow 0.35s ease;
}
.avatar-r {
  background: radial-gradient(circle at 35% 30%, #e5543c, #b8281b 60%, #7a130c);
  color: #fbe6ac;
  border: 3rpx solid #c99a3e;
}
.avatar-b {
  background: radial-gradient(circle at 35% 30%, #4a4b52, #22232a 60%, #0b0b0f);
  color: #eef0f3;
  border: 3rpx solid #9aa0a8;
}
.pinfo {
  display: flex;
  flex-direction: column;
}
.pinfo-right {
  align-items: flex-end;
}
.pname {
  font-size: 22rpx;
  color: var(--sub);
}
.ptime {
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.round {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.round-line {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.round-label {
  font-size: 22rpx;
  color: var(--sub);
}
.round-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gold);
  font-variant-numeric: tabular-nums;
}
.turn-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  transition: all 0.3s ease;
}
.turn-red {
  background: rgba(200, 55, 45, 0.18);
  color: #f08a76;
}
.theme-light .turn-red {
  color: #b42d23;
}
.turn-black {
  background: rgba(223, 227, 232, 0.12);
  color: var(--text);
}
.turn-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  animation: blink 1.4s ease-in-out infinite;
}

.captures {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--glass-border);
}
.cap-row {
  flex: 1;
  min-height: 40rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx;
}
.cap-row-right {
  justify-content: flex-end;
}
.cap-divider {
  width: 1rpx;
  height: 32rpx;
  margin: 0 14rpx;
  background: var(--glass-border);
}
.cap-empty {
  font-size: 20rpx;
  color: var(--sub);
  opacity: 0.7;
}
.mini {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 22rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.35);
  animation: pop-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.mini-r {
  background: radial-gradient(circle at 35% 30%, #e5543c, #9e1f16);
  color: #fbe6ac;
  border: 2rpx solid #c99a3e;
}
.mini-b {
  background: radial-gradient(circle at 35% 30%, #4a4b52, #111215);
  color: #eef0f3;
  border: 2rpx solid #9aa0a8;
}

/* ============================ 棋盘 ============================ */
.board-wrap {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  border-radius: 20px;
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.55), 0 0 0 1rpx rgba(217, 178, 106, 0.18);
}
.board-canvas {
  display: block;
}

/* 将军提示 */
.check-banner {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 300rpx;
  height: 300rpx;
  margin: -150rpx 0 0 -150rpx;
  z-index: 8;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
}
.check-banner.show {
  animation: check-pop 1.3s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
.check-ring {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  left: 40rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 70, 60, 0.85);
  box-shadow: 0 0 60rpx rgba(255, 70, 60, 0.6), inset 0 0 40rpx rgba(255, 70, 60, 0.4);
  background: radial-gradient(circle, rgba(120, 10, 5, 0.75), rgba(120, 10, 5, 0.25) 70%);
}
.check-banner.show .check-ring {
  animation: ring-pulse 1.3s ease-out forwards;
}
.check-text {
  position: relative;
  font-size: 84rpx;
  color: #ffe1c4;
  letter-spacing: 8rpx;
  text-shadow: 0 0 20rpx rgba(255, 70, 60, 0.9), 0 4rpx 0 #7a130c;
}

.check-flash {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  opacity: 0;
  box-shadow: inset 0 0 160rpx rgba(255, 40, 30, 0.75);
  z-index: 5;
}
.check-flash.show {
  animation: flash 1.1s ease-out forwards;
}

/* ============================ 提示语 ============================ */
.tip {
  z-index: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--sub);
  letter-spacing: 2rpx;
}

/* ============================ 底部操作区 ============================ */
.actions {
  z-index: 1;
  width: calc(100% - 48rpx);
  margin-top: auto;
  display: flex;
  gap: 18rpx;
}
.action {
  flex: 1;
  height: 128rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.08), 0 12rpx 30rpx rgba(0, 0, 0, 0.35);
  transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
}
.action-primary {
  background: linear-gradient(160deg, rgba(200, 55, 45, 0.55), rgba(120, 20, 14, 0.55));
  border-color: rgba(243, 209, 132, 0.4);
}
.action-pressed {
  transform: scale(0.94) translateY(2rpx);
  box-shadow: inset 0 4rpx 10rpx rgba(0, 0, 0, 0.35), 0 4rpx 10rpx rgba(0, 0, 0, 0.25);
  background: var(--glass-strong);
}
.action-icon {
  width: 44rpx;
  height: 44rpx;
  filter: var(--icon-filter);
}
.action-primary .action-icon {
  filter: none;
}
.action-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--text);
}
.action-primary .action-label {
  color: #fbe6c4;
}

/* ============================ 设置面板 ============================ */
.mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0);
  transition: background 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mask-show {
  background: rgba(0, 0, 0, 0.55);
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  padding: 20rpx 40rpx 60rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--sheet);
  border-top: 1rpx solid var(--glass-border);
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.4);
  transform: translateY(100%);
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 8rpx;
  background: var(--glass-border);
}
.sheet-title {
  display: block;
  font-size: 40rpx;
  margin-bottom: 16rpx;
  color: var(--text);
}
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--glass-border);
}
.setting-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.setting-name {
  font-size: 30rpx;
  color: var(--text);
}
.setting-desc {
  font-size: 22rpx;
  color: var(--sub);
}
.sheet-done {
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: #fbe6c4;
  background: linear-gradient(160deg, #c8372d, #861a12);
  box-shadow: 0 12rpx 30rpx rgba(200, 55, 45, 0.35);
  transition: transform 0.12s ease;
}

/* ============================ 结算弹窗 ============================ */
.result {
  width: 560rpx;
  padding: 56rpx 40rpx 40rpx;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--sheet);
  box-shadow: var(--shadow);
  animation: result-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.result-seal {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 132rpx;
  font-size: 80rpx;
}
.result-r {
  background: radial-gradient(circle at 35% 30%, #e5543c, #b8281b 60%, #7a130c);
  color: #fbe6ac;
  border: 6rpx solid #c99a3e;
  box-shadow: 0 0 60rpx rgba(229, 84, 60, 0.6);
}
.result-b {
  background: radial-gradient(circle at 35% 30%, #4a4b52, #22232a 60%, #0b0b0f);
  color: #eef0f3;
  border: 6rpx solid #9aa0a8;
  box-shadow: 0 0 60rpx rgba(223, 227, 232, 0.35);
}
.result-title {
  margin-top: 28rpx;
  font-size: 60rpx;
  letter-spacing: 8rpx;
  color: var(--text);
}
.result-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--sub);
}
.result-actions {
  width: 100%;
  margin-top: 44rpx;
  display: flex;
  gap: 20rpx;
}
.result-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  transition: transform 0.12s ease;
}
.result-btn.ghost {
  border: 1rpx solid var(--glass-border);
  color: var(--text);
}
.result-btn.primary {
  color: #fbe6c4;
  background: linear-gradient(160deg, #c8372d, #861a12);
}

/* ============================ 关键帧 ============================ */
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
@keyframes pop-in {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes check-pop {
  0% { opacity: 0; transform: scale(1.8); }
  18% { opacity: 1; transform: scale(0.95); }
  28% { transform: scale(1); }
  75% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(0.9); }
}
@keyframes ring-pulse {
  0% { transform: scale(0.6); }
  30% { transform: scale(1.05); }
  100% { transform: scale(1.2); }
}
@keyframes flash {
  0% { opacity: 0; }
  15% { opacity: 1; }
  100% { opacity: 0; }
}
@keyframes result-in {
  0% { transform: scale(0.8) translateY(40rpx); opacity: 0; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}
